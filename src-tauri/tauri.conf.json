{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PD2 Trader",
  "version": "0.6.1",
  "identifier": "com.pd2-trader.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "mainBinaryName": "pd2-trader-installer",
  "plugins": {
    "shell": {},
    "updater": {
      "windows": {
        "installMode": "passive"
      },
      "endpoints": ["https://github.com/errolgr/pd2-trade/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI2QjU2MzkwQjQ5RTlBMDgKUldRSW1wNjBrR08xSnV6QndCMUhVaWVlWkNJRUtENWZGVzhMSGZGanhKaDQrT2ZONWoxYVZ0RVQK"
    }
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "windows": {
      "nsis": {
        "installerIcon": "icons/favicon.ico",
        "sidebarImage": "icons/banner.bmp"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "librsvg2-2",
          "libsoup-3.0-0",
          "ca-certificates",
          "gstreamer1.0-libav",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-plugins-base"
        ]
      }
    },
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "icon": ["icons/favicon.ico", "icons/favicon-32x32.png"]
  }
}
