{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PD2 Trader",
  "version": "0.10.16",
  "identifier": "com.pd2-trader.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "mainBinaryName": "pd2-trader-installer",
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      },
      "endpoints": ["https://github.com/errolgr/pd2-trade/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI2QjU2MzkwQjQ5RTlBMDgKUldRSW1wNjBrR08xSnV6QndCMUhVaWVlWkNJRUtENWZGVzhMSGZGanhKaDQrT2ZONWoxYVZ0RVQK"
    }
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' data: https://fonts.gstatic.com",
        "img-src": "'self' data: blob: https://pd2trader.com https://projectdiablo2.com",
        "media-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https://pd2trader.com wss://api.projectdiablo2.com https://o427910.ingest.us.sentry.io https://*.grafana.net",
        "worker-src": "'self' blob:",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "windows": {
      "nsis": {
        "installerIcon": "icons/favicon.ico",
        "sidebarImage": "icons/banner.bmp"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "icon": ["icons/favicon.ico", "icons/favicon-32x32.png"]
  }
}
