{
  "name": "@pd2-trader/plugin-sdk",
  "version": "1.0.0",
  "description": "PD2 Trader plugin SDK: manifest schema, slot and UI types, and the worker/panel runtime clients.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react.tsx",
      "default": "./src/react.tsx"
    },
    "./manifest": {
      "require": {
        "types": "./dist/manifest.d.cts",
        "default": "./dist/manifest.cjs"
      },
      "types": "./src/manifest-module.ts",
      "default": "./src/manifest-module.ts"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "manifest": [
        "./dist/manifest.d.cts"
      ]
    }
  },
  "bin": {
    "pd2-plugin": "./bin/pd2-plugin.mjs"
  },
  "files": [
    "src",
    "bin",
    "dist"
  ],
  "peerDependencies": {
    "react": "^18.3.1",
    "zod": "^3.24.0"
  },
  "dependencies": {
    "@pd2-trader/ui": "0.1.0",
    "esbuild": ">=0.20.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
