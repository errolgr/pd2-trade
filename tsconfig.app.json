{
  "compilerOptions": {
    "lib": ["ES2020", "ES2017", "ESNext.Promise", "DOM", "DOM.Iterable"],
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@pd2-trader/ui": ["./vendor/@pd2-trader/ui/src/index.ts"],
      "@pd2-trader/ui/tokens": ["./vendor/@pd2-trader/ui/src/tokens/index.ts"],
      "@pd2-trader/plugin-sdk": ["./vendor/@pd2-trader/plugin-sdk/src/index.ts"],
      "@pd2-trader/plugin-sdk/react": ["./vendor/@pd2-trader/plugin-sdk/src/react.tsx"]
    },
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Node",
    "target": "ESNext",
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "exclude": ["node_modules"]
}
