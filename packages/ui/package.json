{
  "name": "@pd2-trader/ui",
  "version": "0.1.0",
  "private": false,
  "description": "PD2 Trader design system: tokens, themes, the generated Tailwind 4 theme CSS and the React component library.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens": {
      "types": "./src/tokens/index.ts",
      "default": "./src/tokens/index.ts"
    },
    "./tailwind.css": "./generated/tailwind.css",
    "./eslint": "./eslint/design-system.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "generated",
    "eslint",
    "DESIGN_RULES.md",
    "llms.txt"
  ],
  "scripts": {
    "build:css": "tsx scripts/build-css.ts",
    "catalog": "ladle serve",
    "catalog:build": "ladle build"
  },
  "devDependencies": {
    "@ladle/react": "^5.1.1",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.4.2",
    "lucide-react": "^0.475.0",
    "recharts": "^3.5.1",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.1"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2"
  }
}
