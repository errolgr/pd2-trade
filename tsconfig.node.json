{
  "compilerOptions": {
    "lib": ["ES2020", "ES2017", "DOM", "DOM.Iterable"],
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true
  },
  "include": ["vite.config.ts", "packages/ui/scripts/build-css.ts", "packages/ui/src/tokens/*.ts"],
  "exclude": ["node_modules", "**/*.test.ts"]
}
